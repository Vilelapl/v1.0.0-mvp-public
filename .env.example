# Backend: todas las variables de esta sección son obligatorias.
# Copiar a backend/.env para desarrollo; producción las inyecta en el proceso.
NODE_ENV="development"
PORT="3000"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gestor_financiero?schema=public"
# Origen exacto del navegador, sin slash final. Producción exige https://.
WEB_ORIGIN="http://127.0.0.1:5173"
SESSION_COOKIE_NAME="gf_session"
# 12 horas
SESSION_TTL_MINUTES="720"
# Código de emparejamiento de un solo uso: 5 minutos
PAIRING_CODE_TTL_MINUTES=5

# Solo para las pruebas de integración. El nombre de la base debe contener `test`.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gestor_financiero_test?schema=public"

# Administrativas: EMAIL para bootstrap y seed; PASSWORD solo para bootstrap.
# Retirarlas del entorno del servidor al terminar. Contraseña: mínimo 12 caracteres.
BOOTSTRAP_USER_EMAIL="owner@example.com"
BOOTSTRAP_USER_PASSWORD="replace-with-a-long-password"
